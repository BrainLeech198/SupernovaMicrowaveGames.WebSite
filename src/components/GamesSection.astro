---
import GameCard from "./GameCard.astro";
import type { GameProject } from "../data/siteContent";

interface Props {
  games: GameProject[];
}

const { games } = Astro.props;
---

<section class="games section-shell" id="games" aria-labelledby="games-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">PLAY IN PROGRESS</p>
      <h2 id="games-title">游戏作品<span class="heading-mark">.</span></h2>
    </div>
    <p class="section-heading__note">两款游戏正在制作，<br />各自的世界仍在搭建。</p>
  </div>

  <div class="game-grid">
    {games.map((game) => <GameCard game={game} />)}
  </div>
</section>
