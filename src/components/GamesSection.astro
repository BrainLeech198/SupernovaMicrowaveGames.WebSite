---
import GameCard from "./GameCard.astro";
import type { GameProject } from "../data/siteContent";

interface Props {
  games: GameProject[];
}

const { games } = Astro.props;
---

<section class="games section-shell" id="games" aria-labelledby="games-title">
  <div class="section-heading">
    <h2 id="games-title">游戏作品</h2>
    <span class="section-heading__rule" aria-hidden="true"></span>
  </div>

  <div class="game-list">
    {games.map((game) => <GameCard game={game} />)}
  </div>
</section>
