    <img
      src={withBasePath("branding/supernova-microwave-smg.png")}
      alt=""
      width="76"
      height="76"
      loading="lazy"
    />
    <span class="footer-wordmark__text">
      <strong>超新星微波</strong>
      <small>Supernova Microwave Games</small>
    </span>
  </a>
  <p>© 2026 Supernova Microwave Games. All rights reserved.</p>
  <nav class="site-footer__links" aria-label="页脚导航">
    <a href={withBasePath("copyright/")}>版权与素材声明</a>
    <a class="back-top" href="#top">回到顶部</a>
  </nav>
</footer>
