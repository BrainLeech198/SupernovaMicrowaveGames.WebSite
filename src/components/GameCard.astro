---
import type { GameProject } from "../data/siteContent";
import { withBasePath } from "../utils/sitePath";

interface Props {
  game: GameProject;
}

const { game } = Astro.props;
---

<article
  class:list={[
    "game-row",
    game.image ? "game-row--illustrated" : "game-row--type",
    game.website && "game-row--linked",
  ]}
>
  {
    game.image && (
      <img
        class="game-row__image"
        src={withBasePath(game.image)}
        alt={game.imageAlt ?? `${game.title} 游戏画面`}
        width="2560"
        height="1440"
        loading="lazy"
      />
    )
  }
  <div class="game-row__content">
    <p class="game-row__kicker">原创游戏 <span aria-hidden="true">/</span> {game.status}</p>
    <div class="game-row__title">
      <h3>{game.title}</h3>
      {game.subtitle && <p class="game-row__subtitle">{game.subtitle}</p>}
    </div>
    {game.description && <p class="game-row__description">{game.description}</p>}
  </div>
  {!game.image && <span class="game-row__monogram" aria-hidden="true">TB</span>}
  {game.website && <a class="game-row__link" href={game.website} aria-label={`前往 ${game.title} 官网`}><span>访问官网</span></a>}
</article>
