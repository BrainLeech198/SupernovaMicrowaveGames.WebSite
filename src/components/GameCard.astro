---
import type { GameProject } from "../data/siteContent";
import { withBasePath } from "../utils/sitePath";

interface Props {
  game: GameProject;
}

const { game } = Astro.props;
---

<article class:list={["game-row", game.image ? "game-row--illustrated" : "game-row--type", game.website && "game-row--linked"]}>
  {game.image && (
    <div class="game-row__art">
      <img
        class="game-row__image"
        src={withBasePath(game.image)}
        alt={game.imageAlt ?? `${game.title} 游戏画面`}
        width="2560"
        height="1440"
        loading="lazy"
      />
    </div>
  )}
  <div class="game-row__content">
    <div class="game-row__title">
      {game.logo && (
        <img
          class="game-row__logo"
          src={withBasePath(game.logo)}
          alt=""
          aria-hidden="true"
          width="112"
          height="112"
          loading="lazy"
        />
      )}
      <div class="game-row__heading">
        <h3>{game.title}</h3>
        {game.subtitle && <p class="game-row__subtitle">{game.subtitle}</p>}
      </div>
    </div>
    {game.description && <p class="game-row__description">{game.description}</p>}
  </div>
  <div class="game-row__aside">
    <p class="game-row__status"><span aria-hidden="true"></span>{game.status}</p>
    {game.website && (
      <a class="game-row__link" href={game.website} aria-label={`前往 ${game.title} 官网`}>访问官网</a>
    )}
  </div>
</article>
