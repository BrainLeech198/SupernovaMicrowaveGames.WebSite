---
import { withBasePath } from "../utils/sitePath";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <img
    class="hero__image"
    src={withBasePath("game-art/shoreleave.webp")}
    alt="Shoreleave 游戏中的日落海岛景色"
    width="2560"
    height="1440"
    fetchpriority="high"
  />
  <div class="hero__inner section-shell">
    <div class="hero__panel">
      <p class="hero__eyebrow">正在开发</p>
      <h1 id="hero-title">Shoreleave <span>上岸休假</span></h1>
      <p>以海岛为舞台的开放世界休闲游戏。</p>
      <a class="button button--primary" href="#games">浏览游戏作品 <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
