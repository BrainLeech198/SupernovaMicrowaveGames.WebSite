---
import type { StudioMember } from "../data/siteContent";

interface Props {
  members: StudioMember[];
}

const { members } = Astro.props;
---

<section class="members" id="members" aria-labelledby="members-title">
  <div class="members__inner section-shell">
    <header class="members__heading">
      <h2 id="members-title">工作室成员</h2>
    </header>
    <ul class="member-list">
      {members.map((member) => (
        <li class="member-list__item">
          <img class="member-list__mark" src={member.avatar} alt={`${member.name} 的 GitHub 头像`} width="256" height="256" loading="lazy" />
          <span class="member-list__name">{member.name}</span>
          <nav class="member-list__links" aria-label={`${member.name} 的个人主页`}>
            <a href={member.github} target="_blank" rel="noreferrer">GitHub</a>
            <a href={member.gitee} target="_blank" rel="noreferrer">Gitee</a>
          </nav>
        </li>
      ))}
    </ul>
  </div>
</section>
