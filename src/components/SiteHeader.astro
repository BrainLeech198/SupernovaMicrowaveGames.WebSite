---
import { withBasePath } from "../utils/sitePath";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href={`${withBasePath("")}#top`} aria-label="超新星微波，返回首页">
      <img
        class="wordmark__symbol"
        src={withBasePath("branding/supernova-microwave-smg.png")}
        alt=""
        width="76"
        height="76"
      />
      <span class="wordmark__text">
        <strong>超新星微波</strong>
        <small>Supernova Microwave Games</small>
      </span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href={`${withBasePath("")}#games`}>游戏</a>
      <a href={`${withBasePath("")}#members`}>成员</a>
      <a href={`${withBasePath("")}#studio`}>关于</a>
    </nav>
  </div>
</header>
