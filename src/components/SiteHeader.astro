---
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="#top" aria-label="超新星微波，返回首页">
      <img
        class="wordmark__symbol"
        src={`${baseUrl}branding/supernova-microwave-smg.png`}
        alt=""
        width="76"
        height="76"
      />
      <span class="wordmark__text">
        <strong>超新星微波</strong>
        <small>Supernova Microwave Games</small>
      </span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href="#games">游戏</a>
      <a href="#members">成员</a>
      <a href="#studio">关于</a>
    </nav>
  </div>
</header>
